# Android upload key for Google Play (RELEASE_KIT 1c item 2). The OWNER creates the key and this file; Claude never does.
# 1. Create the key once (Terminal):  keytool -genkeypair -v -keystore ~/maker-print-upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# 2. Copy this file to "keystore.properties" (same folder as package.json; git ignores it) and fill in the four values.
# 3. scripts/bundle-release.sh production   → the .aab is signed with this key (plugins/with-release-signing.js).
# storeFile is RELATIVE to this file's folder (an absolute path does not work): ../../maker-print-upload.jks = the file in your home folder
# when the project is ~/Developer/maker-print. Keep a backup of the .jks and the passwords: Play needs the same key for every update.
storeFile=../../maker-print-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
